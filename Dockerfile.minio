FROM debian:bookworm-slim

# Official release assets; do not depend on retired MinIO container registries.
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
        amd64) arch=amd64; checksum=7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f ;; \
        arm64) arch=arm64; checksum=5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d ;; \
        *) echo 'Unsupported MinIO architecture' >&2; exit 1 ;; \
    esac \
    && curl --fail --location --retry 3 --connect-timeout 20 --max-time 300 \
        "https://github.com/minio/minio/releases/download/RELEASE.2025-09-07T16-13-09Z/minio.linux-${arch}.RELEASE.2025-09-07T16-13-09Z" \
        -o /usr/local/bin/minio \
    && echo "${checksum}  /usr/local/bin/minio" | sha256sum --check --strict \
    && chmod +x /usr/local/bin/minio \
    && minio --version
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
