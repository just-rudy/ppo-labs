# Скопируйте в .env в корне проекта:
#   cp env.example .env
#
# --- Вариант A: локальный PostgreSQL (без Docker), peer auth ---
# Пользователь ОС должен иметь право CREATE DB (как у вас: rudy).
# База: cool_magic_battles (создаётся скриптом или вручную).
DATABASE_URL=postgresql+psycopg:///cool_magic_battles

# --- Вариант B: Docker (make db-up) — порт 5433, см. docker-compose.yml ---
# DATABASE_URL=postgresql+psycopg://cmb:cmb@localhost:5433/cool_magic_battles

# --- Redis — внешний кэш каталога карт (make redis-up) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_CATALOG_TTL_SECONDS=300

# --- MinIO (make minio-up) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cards
MINIO_SECURE=false
MINIO_PRESIGN_TTL_SECONDS=3600
MINIO_AUTO_CREATE_BUCKET=true

# Если захотите отдавать картинки по публичному URL без presigned-ссылок:
# MINIO_PUBLIC_BASE_URL=http://localhost:9000
